{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chorus Deck",
  "version": "5.1.0",
  "identifier": "com.chorusdeck.app",
  "build": {
    "frontendDist": "../../src/renderer/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chorus Deck",
        "label": "main",
        "width": 1020,
        "height": 640,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      },
      {
        "label": "dynamic-island",
        "title": "Dynamic Island",
        "url": "index.html#/dynamic-island",
        "width": 500,
        "height": 200,
        "resizable": false,
        "fullscreen": false,
        "center": false,
        "focus": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Chorus Deck",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Chorus Deck",
    "longDescription": "Chorus Deck music player"
  }
}
